{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tasks"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/id"
    },
    "executors": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/executor"
      }
    },
    "tasks": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "path": {
      "type": "string",
      "pattern": "^/"
    },
    "env": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[^=]+$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "executor": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "run"
          ],
          "properties": {
            "type": {
              "const": "acp"
            },
            "cwd": {
              "$ref": "#/$defs/path"
            },
            "run": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "env": {
              "$ref": "#/$defs/env"
            },
            "envFile": {
              "$ref": "#/$defs/path"
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "mode": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "process"
            },
            "cwd": {
              "$ref": "#/$defs/path"
            },
            "env": {
              "$ref": "#/$defs/env"
            },
            "envFile": {
              "$ref": "#/$defs/path"
            }
          }
        }
      ]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs"
      ],
      "properties": {
        "executor": {
          "$ref": "#/$defs/id"
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "inputs": {
          "type": "object"
        },
        "prompt": {
          "type": "string"
        },
        "run": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "outputSchema": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "interactive": {
          "type": "boolean"
        },
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prompt"
          ],
          "properties": {
            "prompt": {
              "type": "string",
              "minLength": 1
            },
            "schema": {
              "anyOf": [
                {
                  "type": "object"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          }
        },
        "session": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "fresh",
                "continue",
                "fork"
              ]
            },
            "from": {
              "$ref": "#/$defs/id"
            }
          }
        },
        "when": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "equals": {},
              "in": {
                "type": "array"
              }
            }
          }
        },
        "map": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "over",
            "key",
            "concurrency"
          ],
          "properties": {
            "over": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "minLength": 1
            },
            "concurrency": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "rerun": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "max"
          ],
          "properties": {
            "from": {
              "$ref": "#/$defs/id"
            },
            "max": {
              "type": "integer",
              "minimum": 1
            },
            "atMax": {
              "enum": [
                "block",
                "proceed"
              ]
            },
            "when": {
              "$ref": "#/$defs/task/properties/when"
            }
          }
        }
      }
    }
  }
}
